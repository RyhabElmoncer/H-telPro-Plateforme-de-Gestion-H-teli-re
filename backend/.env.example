NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hotel_platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@hotel.com
FROM_NAME=Hotel Platform

# n8n Webhook URLs
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_RESERVATION=http://localhost:5678/webhook/reservation
N8N_WEBHOOK_PAYMENT=http://localhost:5678/webhook/payment
N8N_WEBHOOK_PROMO=http://localhost:5678/webhook/promo

# Upload
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880
